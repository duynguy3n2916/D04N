# ===== Database: Postgres cloud (Neon) =====
# Postgres cloud (Neon). Dùng direct connection, sslmode=require
DATABASE_URL=
# Database RIÊNG cho pytest (tên phải có chữ 'test'), không trỏ tới DATABASE_URL
TEST_DATABASE_URL=

# ===== LLM: OpenAI =====
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Đơn giá (USD / 1 triệu token) để ước tính chi phí trong báo cáo. Để 0 nếu không cần.
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0

# ===== Embedding (local không cần API key) =====
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# ===== Speech-to-Text: groq | openai =====
WHISPER_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ===== Bảo mật & tài khoản =====
# Chuỗi bí mật ký JWT (ngẫu nhiên, dài >= 32 ký tự). Tạo nhanh: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai
# Thời hạn một phiên đăng nhập (phút)
JWT_TTL_MINUTES=720
# Học sinh tự tạo tài khoản ở màn hình đăng nhập (có thể kèm mã vào lớp)
ALLOW_REGISTRATION=true
# Dòng gợi ý dưới form đăng nhập, ví dụ khi demo: "Demo: sv-01 / gv-demo / admin — mật khẩu Demo@2026"
LOGIN_HINT=
# Chỉ dùng khi tích hợp LMS: chấp nhận token do LMS ký (cùng JWT_SECRET) cho người dùng chưa có tài khoản
ALLOW_EXTERNAL_TOKENS=false
# Chỉ dùng cho kiểm thử tự động: cấp token không cần mật khẩu. LUÔN để false khi chạy thật.
ALLOW_TEST_LOGIN=false
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,null

# ===== RAG & Workflow (có thể giữ mặc định) =====
RAG_TOP_K=5
RAG_MIN_SCORE=0.30
QUESTION_TIMEOUT_SECONDS=120
# Số lượt hỏi Tutor mỗi học sinh / bài / ngày (0 = không giới hạn)
TUTOR_DAILY_LIMIT_PER_LESSON=15
# Bài kiểm tra làm dở trong N phút thì Tutor chỉ gợi ý, không nói đáp án
QUIZ_GUARD_MINUTES=90

# ===== Guardrail dữ liệu =====
# Che email / số điện thoại trong câu hỏi trước khi lưu và gửi LLM
REDACT_PII=true
# Thời hạn lưu (ngày, 0 = giữ mãi): tin nhắn Tutor và nhật ký gọi LLM
CHAT_RETENTION_DAYS=365
LLM_LOG_RETENTION_DAYS=180
AGENT_COOLDOWN_SECONDS=300

# MEDIA_STORAGE=r2 để lưu tài liệu, video, ảnh bìa lên Cloudflare R2; để local thì dùng STORAGE_PATH
MEDIA_STORAGE=local
# Thư mục lưu file khi MEDIA_STORAGE=local (mặc định ./storage)
# STORAGE_PATH=./storage
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
