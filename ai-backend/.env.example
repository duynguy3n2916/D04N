# ===== Database (docker compose mở Postgres ở cổng 5433) =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_learning

# ===== LLM: claude | openai =====
LLM_PROVIDER=claude
CLAUDE_API_KEY=sk-ant-...
# Để trống để dùng endpoint mặc định của Anthropic (https://api.anthropic.com).
# Chỉ điền nếu bạn dùng proxy/gateway riêng tương thích Anthropic API.
CLAUDE_BASE_URL=
CLAUDE_LLM_MODEL=claude-fable-5

# Dự phòng nếu dùng OpenAI
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Đơn giá (USD / 1 triệu token) để ước tính chi phí trong báo cáo. Để 0 nếu không cần.
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0

# ===== Embedding (local không cần API key) =====
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# ===== Speech-to-Text: groq | openai =====
WHISPER_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ===== Bảo mật & tài khoản =====
# Chuỗi bí mật ký JWT (ngẫu nhiên, dài >= 32 ký tự). Tạo nhanh: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai
# Thời hạn một phiên đăng nhập (phút)
JWT_TTL_MINUTES=720
# Học sinh tự tạo tài khoản ở màn hình đăng nhập (có thể kèm mã vào lớp)
ALLOW_REGISTRATION=true
# Dòng gợi ý dưới form đăng nhập, ví dụ khi demo: "Demo: sv-01 / gv-demo / admin — mật khẩu Demo@2026"
LOGIN_HINT=
# Chỉ dùng khi tích hợp LMS: chấp nhận token do LMS ký (cùng JWT_SECRET) cho người dùng chưa có tài khoản
ALLOW_EXTERNAL_TOKENS=false
# Chỉ dùng cho kiểm thử tự động: cấp token không cần mật khẩu. LUÔN để false khi chạy thật.
ALLOW_TEST_LOGIN=false
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,null

# ===== RAG & Workflow (có thể giữ mặc định) =====
RAG_TOP_K=5
RAG_MIN_SCORE=0.30
QUESTION_TIMEOUT_SECONDS=120
AGENT_COOLDOWN_SECONDS=300

STORAGE_PATH=./storage
